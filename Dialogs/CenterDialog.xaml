<Window x:Class="SnapAfghanistan.Native.Dialogs.CenterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مرکز همکار" Width="920" Height="740" MinWidth="800" MinHeight="650" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="../Assets/snap.ico">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition/><RowDefinition Height="76"/></Grid.RowDefinitions>
        <Border Background="{StaticResource NavyBrush}" Padding="28,16"><StackPanel><TextBlock x:Name="HeaderTitle" Text="ثبت مرکز جدید" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="هویت مرکز، قرارداد، تخفیف و مدل همکاری" Foreground="#B6C9D6" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardStyle}" Margin="20" Padding="24"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="2"><TextBlock Text="کد مرکز" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="CodeText" IsReadOnly="True" Text="پس از ذخیره ساخته می‌شود"/></StackPanel><StackPanel Grid.Column="0"><TextBlock Text="سکتور *" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="SectorCombo" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel></Grid>
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="2"><TextBlock Text="نام قانونی مرکز *" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="LegalNameText"/></StackPanel><StackPanel Grid.Column="0"><TextBlock Text="نام تجارتی" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="TradeNameText"/></StackPanel></Grid>
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="2"><TextBlock Text="شماره جواز" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="LicenseText" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel><StackPanel Grid.Column="0"><TextBlock Text="نام نماینده" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="RepresentativeText"/></StackPanel></Grid>
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="2"><TextBlock Text="شماره موبایل" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="PhoneText" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel><StackPanel Grid.Column="0"><TextBlock Text="تخفیف توافق‌شده" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="DiscountText" ToolTip="مثلاً ۲۰ فیصد یا ۱۵ تا ۳۰ فیصد"/></StackPanel></Grid>
                <TextBlock Text="آدرس مرکز" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7"/><TextBox x:Name="AddressText"/>
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="2"><TextBlock Text="آغاز قرارداد (هجری شمسی)" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="ContractStartText" FlowDirection="LeftToRight" TextAlignment="Left" ToolTip="مثال: 1405/05/30"/><TextBlock x:Name="ContractStartGregorian" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="0"><TextBlock Text="پایان قرارداد (هجری شمسی)" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="ContractEndText" FlowDirection="LeftToRight" TextAlignment="Left" ToolTip="اختیاری"/><TextBlock x:Name="ContractEndGregorian" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid>
                <Border Background="#F2F7FA" CornerRadius="12" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="مدل همکاری مالی" FontWeight="Bold" FontSize="15"/><TextBlock Text="برای اشتراک ماهانه، مبلغ و سررسید از صفحه «اشتراک مراکز» تنظیم می‌شود." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,13"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="2"><TextBlock Text="نوع همکاری" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="FeeBasisCombo"/></StackPanel><StackPanel Grid.Column="0"><TextBlock Text="نرخ / مبلغ توافقی" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="FeeAmountText" FlowDirection="LeftToRight" TextAlignment="Left" ToolTip="برای فیصدی: عدد فیصد؛ برای روزانه: مبلغ افغانی"/></StackPanel></Grid></StackPanel></Border>
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="2"><TextBlock Text="توضیحات" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="NotesText" Height="78" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/></StackPanel><StackPanel Grid.Column="0"><TextBlock Text="وضعیت مرکز" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="StatusCombo"/></StackPanel></Grid>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel></Border>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,14"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="انصراف" Style="{StaticResource GhostButton}" Width="115" IsCancel="True"/><Button Content="ذخیره مرکز" Style="{StaticResource PrimaryButton}" Width="150" Margin="10,0,0,0" Click="Save_Click"/></StackPanel></Border>
    </Grid>
</Window>