<Window x:Class="SnapAfghanistan.Native.Dialogs.NetworkSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیم شبکه اسنپ افغانستان" Width="760" Height="650" MinWidth="680" MinHeight="580"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Icon="../Assets/snap.ico" FlowDirection="RightToLeft">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,14">
            <StackPanel><TextBlock Text="راه‌اندازی شبکه دفتر" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="یک‌بار مشخص کنید این کمپیوتر میزبان اطلاعات است یا به کمپیوتر اصلی وصل می‌شود." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <RadioButton x:Name="ServerMode" Content="این کمپیوتر، کمپیوتر اصلی / Server است" FontWeight="SemiBold" FontSize="15" Checked="Mode_Changed"/>
                        <TextBlock Text="دیتابیس، تذکره‌ها و بکاپ‌ها فقط روی این کمپیوتر نگهداری می‌شوند. سایر کمپیوترها از طریق Wi‑Fi یا LAN وصل می‌شوند." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="28,7,0,0"/>
                        <Border x:Name="ServerPanel" Background="#F3F7F9" CornerRadius="10" Padding="14" Margin="28,14,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="2"><TextBlock Text="آدرس این کمپیوتر در شبکه" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="ServerAddress" IsReadOnly="True" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel>
                                <StackPanel Grid.Column="0"><TextBlock Text="کُد اتصال امن" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="ServerSecret" IsReadOnly="True" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>
                        <RadioButton x:Name="ClientMode" Content="این کمپیوتر، کاربر / Client است" FontWeight="SemiBold" FontSize="15" Checked="Mode_Changed"/>
                        <TextBlock Text="آدرس و کُد اتصال کمپیوتر اصلی را وارد کنید. دیتابیس جداگانه روی این دستگاه ساخته نمی‌شود." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="28,7,0,0"/>
                        <Grid x:Name="ClientPanel" Margin="28,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="2"><TextBlock Text="IP کمپیوتر اصلی" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="ClientHost" Text="192.168.1.2" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel>
                            <StackPanel Grid.Column="0"><TextBlock Text="کُد اتصال امن" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="ClientSecret" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel>
                        </Grid>
                        <Button x:Name="TestButton" Content="آزمایش اتصال" Style="{StaticResource SecondaryButton}" Width="135" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Test_Click"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="5,12,5,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="انصراف" Style="{StaticResource GhostButton}" Width="100" IsCancel="True"/><Button Content="تأیید و ادامه" Style="{StaticResource PrimaryButton}" Width="135" Margin="8,0,0,0" Click="Save_Click"/></StackPanel>
        </Border>
    </Grid>
</Window>
