<Window x:Class="SnapAfghanistan.Native.Dialogs.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="یادداشت" Width="650" Height="650" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="../Assets/snap.ico">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20"><Border Style="{StaticResource CardStyle}" Padding="24"><ScrollViewer><StackPanel>
        <TextBlock x:Name="HeaderTitle" Text="یادداشت جدید" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,22"/>
        <TextBlock Text="عنوان *" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="TitleText"/>
        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="2"><TextBlock Text="نوع" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="TypeCombo"/></StackPanel><StackPanel Grid.Column="0"><TextBlock Text="اولویت" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="PriorityCombo"/></StackPanel></Grid>
        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="2"><TextBlock Text="شخص / مرکز مرتبط" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="RelatedText"/></StackPanel><StackPanel Grid.Column="0"><TextBlock Text="وضعیت" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="StatusCombo"/></StackPanel></Grid>
        <TextBlock Text="موعد (میلادی)" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7"/><DatePicker x:Name="DueDate" SelectedDateChanged="Date_Changed"/><TextBlock x:Name="DueSolar" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
        <TextBlock Text="متن یادداشت *" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7"/><TextBox x:Name="BodyText" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0"><Button Content="انصراف" Style="{StaticResource GhostButton}" Width="105" IsCancel="True"/><Button Content="ذخیره یادداشت" Style="{StaticResource PrimaryButton}" Width="145" Margin="8,0,0,0" Click="Save_Click"/></StackPanel>
    </StackPanel></ScrollViewer></Border></Grid>
</Window>
