<Window x:Class="SnapAfghanistan.Native.Dialogs.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ثبت پرداخت" Width="590" Height="650" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="../Assets/snap.ico">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20"><Border Style="{StaticResource CardStyle}" Padding="24"><ScrollViewer><StackPanel>
        <TextBlock Text="ثبت پرداخت اشتراک" Style="{StaticResource PageTitleStyle}"/><TextBlock x:Name="CenterName" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
        <TextBlock Text="مبلغ پرداخت (افغانی)" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="AmountText" FlowDirection="LeftToRight" TextAlignment="Left"/>
        <TextBlock Text="تاریخ پرداخت (میلادی)" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7"/><DatePicker x:Name="PaymentDate" SelectedDateChanged="Date_Changed"/><TextBlock x:Name="PaymentSolar" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
        <TextBlock Text="تعداد ماه پوشش" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7"/><ComboBox x:Name="MonthsCombo"/>
        <TextBlock Text="شماره رسید" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7"/><TextBox x:Name="ReceiptText" FlowDirection="LeftToRight" TextAlignment="Left"/><TextBlock Text="اگر خالی باشد، سیستم شماره رسید می‌سازد." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
        <TextBlock Text="توضیحات" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7"/><TextBox x:Name="NotesText" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,19,0,0"><Button Content="انصراف" Style="{StaticResource GhostButton}" Width="105" IsCancel="True"/><Button Content="ثبت و صدور رسید" Style="{StaticResource SuccessButton}" Width="155" Margin="8,0,0,0" Click="Save_Click"/></StackPanel>
    </StackPanel></ScrollViewer></Border></Grid>
</Window>
