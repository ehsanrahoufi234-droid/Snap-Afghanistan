<Window x:Class="SnapAfghanistan.Native.Dialogs.PaymentHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سوابق پرداخت" Width="900" Height="590" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="../Assets/snap.ico">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="سوابق پرداخت اشتراک" Style="{StaticResource PageTitleStyle}"/><TextBlock x:Name="CenterName" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True"><DataGrid x:Name="Grid" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="تاریخ" Binding="{Binding PaymentDate}" Width="110"/><DataGridTextColumn Header="مبلغ" Binding="{Binding AmountText}" Width="140"/><DataGridTextColumn Header="شماره رسید" Binding="{Binding ReceiptNo}" Width="160"/><DataGridTextColumn Header="ماه" Binding="{Binding CoveredMonths}" Width="70"/><DataGridTextColumn Header="سررسید جدید" Binding="{Binding NewDueDate}" Width="120"/><DataGridTextColumn Header="توضیحات" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid></Border><Button Grid.Row="2" Content="بستن" Style="{StaticResource GhostButton}" Width="110" HorizontalAlignment="Left" Margin="0,12,0,0" IsCancel="True"/></Grid>
</Window>
