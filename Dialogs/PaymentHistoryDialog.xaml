<Window x:Class="SnapAfghanistan.Native.Dialogs.PaymentHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سوابق پرداخت" Width="980" Height="640" MinWidth="800" MinHeight="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="../Assets/snap.ico">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Margin="18,18,18,12"><StackPanel><TextBlock Text="سوابق پرداخت اشتراک" Style="{StaticResource PageTitleStyle}"/><TextBlock x:Name="CenterName" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/><TextBlock Text="اصلاح یا حذف پرداخت، سررسید مرکز و آمار درآمد را دوباره محاسبه می‌کند." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,6,0,0"/></StackPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="18,0,18,12" Padding="11"><WrapPanel HorizontalAlignment="Right"><Button x:Name="EditButton" Content="ویرایش پرداخت" Style="{StaticResource SecondaryButton}" MinWidth="125" Click="Edit_Click"/><Button x:Name="DeleteButton" Content="حذف پرداخت" Style="{StaticResource DangerButton}" MinWidth="120" Margin="8,0,0,0" Click="Delete_Click"/></WrapPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="18,0" Padding="0" ClipToBounds="True"><DataGrid x:Name="Grid" AlternationCount="2" MouseDoubleClick="Grid_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="تاریخ شمسی" Binding="{Binding PaymentDateSolar}" Width="120"/><DataGridTextColumn Header="مبلغ" Binding="{Binding AmountText}" Width="145"/><DataGridTextColumn Header="شماره رسید" Binding="{Binding ReceiptNo}" Width="165"/><DataGridTextColumn Header="ماه" Binding="{Binding CoveredMonths}" Width="70"/><DataGridTextColumn Header="سررسید جدید" Binding="{Binding NewDueDateSolar}" Width="130"/><DataGridTextColumn Header="توضیحات" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid></Border>
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,12" Margin="0,12,0,0"><Button Content="بستن" Style="{StaticResource GhostButton}" Width="110" HorizontalAlignment="Left" IsCancel="True"/></Border>
    </Grid>
</Window>