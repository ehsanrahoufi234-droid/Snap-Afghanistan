<Window x:Class="SnapAfghanistan.Native.Dialogs.SectorsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیریت سکتورها" Width="820" Height="640" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="../Assets/snap.ico">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="مدیریت سکتورها" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="افزودن، ویرایش، بایگانی و حذف سکتورهای خدماتی" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True"><DataGrid x:Name="Grid" AlternationCount="2" MouseDoubleClick="Edit_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="نام سکتور" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="توضیحات" Binding="{Binding Description}" Width="3*"/><DataGridTextColumn Header="مراکز" Binding="{Binding CenterCount}" Width="80"/><DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="90"/></DataGrid.Columns></DataGrid></Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,12,0,0"><Grid><WrapPanel HorizontalAlignment="Right"><Button Content="＋ سکتور جدید" Style="{StaticResource SuccessButton}" Click="Add_Click"/><Button Content="ویرایش" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Edit_Click"/><Button Content="بایگانی" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Archive_Click"/><Button x:Name="ArchivedButton" Content="بایگانی‌شده‌ها" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Archived_Click"/><Button Content="حذف" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click"/></WrapPanel><Button Content="بستن" Style="{StaticResource GhostButton}" Width="100" HorizontalAlignment="Left" IsCancel="True"/></Grid></Border>
    </Grid>
</Window>