<Window x:Class="SnapAfghanistan.Native.Dialogs.SubscriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیم اشتراک" Width="560" Height="550" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="../Assets/snap.ico">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20"><Border Style="{StaticResource CardStyle}" Padding="24"><StackPanel>
        <TextBlock Text="تنظیم اشتراک ماهانه" Style="{StaticResource PageTitleStyle}"/><TextBlock x:Name="CenterName" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
        <TextBlock Text="مبلغ اشتراک ماهانه (افغانی)" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="AmountText" FlowDirection="LeftToRight" TextAlignment="Left"/>
        <TextBlock Text="تاریخ آغاز (میلادی)" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7"/><DatePicker x:Name="StartDate" SelectedDateChanged="Date_Changed"/><TextBlock x:Name="StartSolar" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
        <TextBlock Text="سررسید بعدی (میلادی)" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7"/><DatePicker x:Name="DueDate" SelectedDateChanged="Date_Changed"/><TextBlock x:Name="DueSolar" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
        <CheckBox x:Name="SuspendedCheck" Content="اشتراک فعلاً در حالت تعلیق باشد" Margin="0,17,0,0" FontWeight="SemiBold"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,19,0,0"><Button Content="انصراف" Style="{StaticResource GhostButton}" Width="105" IsCancel="True"/><Button Content="ذخیره اشتراک" Style="{StaticResource PrimaryButton}" Width="145" Margin="8,0,0,0" Click="Save_Click"/></StackPanel>
    </StackPanel></Border></Grid>
</Window>
