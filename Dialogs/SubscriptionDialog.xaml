<Window x:Class="SnapAfghanistan.Native.Dialogs.SubscriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیم اشتراک"
        Width="600" Height="620" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" Icon="../Assets/snap.ico"
        FlowDirection="RightToLeft">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource CardStyle}" Margin="20,20,20,12" Padding="24">
                <StackPanel>
                    <TextBlock Text="تنظیم اشتراک ماهانه" Style="{StaticResource PageTitleStyle}" TextAlignment="Right"/>
                    <TextBlock x:Name="CenterName" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22" TextAlignment="Right"/>

                    <TextBlock Text="مبلغ اشتراک ماهانه (افغانی)" Style="{StaticResource FieldLabelStyle}" TextAlignment="Right"/>
                    <TextBox x:Name="AmountText" FlowDirection="LeftToRight" TextAlignment="Left"/>

                    <TextBlock Text="تاریخ آغاز (میلادی)" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7" TextAlignment="Right"/>
                    <DatePicker x:Name="StartDate" SelectedDateChanged="Date_Changed" FlowDirection="LeftToRight"/>
                    <TextBlock x:Name="StartSolar" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextAlignment="Right"/>

                    <TextBlock Text="سررسید بعدی (میلادی)" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7" TextAlignment="Right"/>
                    <DatePicker x:Name="DueDate" SelectedDateChanged="Date_Changed" FlowDirection="LeftToRight"/>
                    <TextBlock x:Name="DueSolar" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextAlignment="Right"/>

                    <CheckBox x:Name="SuspendedCheck" Content="اشتراک فعلاً در حالت تعلیق باشد" Margin="0,17,0,0" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Right"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                <Button Content="انصراف" Style="{StaticResource GhostButton}" Width="110" IsCancel="True"/>
                <Button Content="تأیید و ذخیره" Style="{StaticResource PrimaryButton}" Width="155" Margin="10,0,0,0" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
