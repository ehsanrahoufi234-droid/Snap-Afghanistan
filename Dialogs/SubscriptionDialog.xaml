<Window x:Class="SnapAfghanistan.Native.Dialogs.SubscriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیم اشتراک" Width="600" Height="610" MinWidth="520" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize" Icon="../Assets/snap.ico" FlowDirection="RightToLeft">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource CardStyle}" Margin="20,20,20,12" Padding="24"><StackPanel>
                <TextBlock Text="تنظیم اشتراک ماهانه" Style="{StaticResource PageTitleStyle}" TextAlignment="Right"/>
                <TextBlock x:Name="CenterName" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22" TextAlignment="Right"/>
                <TextBlock Text="مبلغ اشتراک ماهانه (افغانی)" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="AmountText" FlowDirection="LeftToRight" TextAlignment="Left"/>
                <TextBlock Text="تاریخ آغاز (هجری شمسی)" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7"/><TextBox x:Name="StartDateText" FlowDirection="LeftToRight" TextAlignment="Left" ToolTip="مثال: 1405/05/30"/><TextBlock x:Name="StartGregorian" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                <TextBlock Text="سررسید بعدی (هجری شمسی)" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7"/><TextBox x:Name="DueDateText" FlowDirection="LeftToRight" TextAlignment="Left" ToolTip="مثال: 1405/06/30"/><TextBlock x:Name="DueGregorian" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                <CheckBox x:Name="SuspendedCheck" Content="اشتراک فعلاً در حالت تعلیق باشد" Margin="0,17,0,0" FontWeight="SemiBold"/>
                <TextBlock Text="نکته: پرداخت‌ها سررسید را از همین تاریخ پایه جلو می‌برند؛ پرداخت دیرهنگام بدهی ماه‌های قبل را حذف نمی‌کند." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>
        </ScrollViewer>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,14"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight"><Button Content="انصراف" Style="{StaticResource GhostButton}" Width="110" IsCancel="True"/><Button Content="تأیید و ذخیره" Style="{StaticResource PrimaryButton}" Width="155" Margin="10,0,0,0" Click="Save_Click" IsDefault="True"/></StackPanel></Border>
    </Grid>
</Window>