<Window x:Class="SnapAfghanistan.Native.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورود — اسنپ افغانستان" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" ResizeMode="CanResize"
        Icon="Assets/snap.ico" KeyDown="Window_KeyDown">
    <Grid FlowDirection="LeftToRight" Background="#F3F7FA">
        <Grid.ColumnDefinitions><ColumnDefinition Width="44*"/><ColumnDefinition Width="56*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" FlowDirection="RightToLeft" Background="#F5F8FA">
            <Border MaxWidth="430" Padding="34,30" Background="White" CornerRadius="24" BorderBrush="#E1E9EF" BorderThickness="1" Effect="{StaticResource FloatingShadow}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="34,28">
                <StackPanel>
                    <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Width="44" Height="44" Background="#E6F2F7" CornerRadius="13"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" FlowDirection="RightToLeft" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="درگاه کاربران" Style="{StaticResource EyebrowStyle}" TextAlignment="Right"/><TextBlock Text="ورود به اسنپ افغانستان" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" TextAlignment="Right"/></StackPanel></Grid>
                    <Border Height="1" Background="#E7EDF2" Margin="0,20,0,21"/>
                    <TextBlock x:Name="ModeText" Text="ورود امن به سامانه" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,18" TextAlignment="Right"/>
                    <TextBlock Text="نام کاربری" Style="{StaticResource FieldLabelStyle}" TextAlignment="Right"/><TextBox x:Name="Username" Text="admin" FlowDirection="LeftToRight" TextAlignment="Left"/>
                    <TextBlock Text="رمز عبور" Style="{StaticResource FieldLabelStyle}" Margin="0,15,0,7" TextAlignment="Right"/><PasswordBox x:Name="Password" FlowDirection="LeftToRight"/>
                    <StackPanel x:Name="ConfirmPanel" FlowDirection="RightToLeft"><TextBlock Text="تکرار رمز عبور" Style="{StaticResource FieldLabelStyle}" Margin="0,15,0,7" TextAlignment="Right"/><PasswordBox x:Name="ConfirmPassword" FlowDirection="LeftToRight"/></StackPanel>
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right" Margin="0,11,0,0" MinHeight="20"/>
                    <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Content="ورود به سامانه" Margin="0,11,0,0" Height="50" FontSize="14" Click="Login_Click"/>
                    <Border Background="#F3F7F9" CornerRadius="10" Padding="12,9" Margin="0,15,0,0"><TextBlock Text="نسخه 1.4 از حساب‌های مستقل و شبکه داخلی رمزگذاری‌شده پشتیبانی می‌کند." Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/></Border>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Column="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#082A45" Offset="0"/><GradientStop Color="#0C5576" Offset="0.56"/><GradientStop Color="#0B806D" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid ClipToBounds="True" FlowDirection="RightToLeft"><Ellipse Width="660" Height="660" Fill="#08FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-250,-330,0,0"/><Ellipse Width="430" Height="430" Fill="#07FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-170,-210"/>
                <StackPanel MaxWidth="590" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="42,32"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="138"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Width="138" Height="98" Padding="10" Background="#F7FFFFFF" CornerRadius="18"><Image Source="Assets/snap-logo.png" Stretch="Uniform"/></Border><StackPanel Grid.Column="2" FlowDirection="RightToLeft" VerticalAlignment="Center"><TextBlock Text="اسنپ افغانستان" Foreground="White" FontSize="38" FontWeight="SemiBold" TextAlignment="Right"/><TextBlock Text="سامانه مدیریت اعضا و مراکز" Foreground="#BFDCE8" FontSize="14" Margin="0,7,0,0" TextAlignment="Right"/></StackPanel></Grid>
                    <TextBlock Text="یک دیتابیس مرکزی، چند کاربر مستقل" Foreground="White" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right" Margin="0,34,0,9"/>
                    <TextBlock Text="مدیر، حسابدار و کارمند می‌توانند روی شبکه داخلی دفتر با صلاحیت مشخص و ثبت تاریخچه عملیات کار کنند؛ اینترنت لازم نیست." Foreground="#D6E7EE" FontSize="15" LineHeight="28" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="560"/>
                    <Grid Margin="0,30,0,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="13"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#16FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16,13"><StackPanel><TextBlock Text="دیتابیس مرکزی" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="بدون اشتراک فایل SQLite" Foreground="#BDD4DE" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="#16FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16,13"><StackPanel><TextBlock Text="شبکه امن داخلی" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="بدون نیاز به اینترنت" Foreground="#BDD4DE" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border></Grid>
                    <TextBlock Text="SNAP DESKTOP  •  VERSION 1.4" Foreground="#8DB5C5" FontSize="10" FontWeight="Bold" FlowDirection="LeftToRight" Margin="0,34,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>