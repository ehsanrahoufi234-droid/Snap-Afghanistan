<Window x:Class="SnapAfghanistan.Native.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورود — اسنپ افغانستان" Width="1100" Height="700" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Icon="Assets/snap.ico"
        KeyDown="Window_KeyDown">
    <Grid FlowDirection="RightToLeft">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B2637" Offset="0"/><GradientStop Color="#176B87" Offset="0.58"/><GradientStop Color="#078A68" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ClipToBounds="True">
                <Ellipse Width="520" Height="520" Fill="#0BFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-250,0,0"/>
                <Ellipse Width="360" Height="360" Fill="#08FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-140,-160"/>
                <StackPanel Width="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="180" Height="125" Padding="12" HorizontalAlignment="Right" Background="#F5FFFFFF" CornerRadius="18">
                        <Image Source="Assets/snap-logo.png" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="اسنپ افغانستان" Foreground="White" FontSize="39" FontWeight="Bold" Margin="0,30,0,12"/>
                    <TextBlock Text="سامانه حرفه‌ای مدیریت اعضا، سکتورها، مراکز و اشتراک‌ها" Foreground="#DCECF2" FontSize="17" TextWrapping="Wrap"/>
                    <Border Background="#18FFFFFF" CornerRadius="13" Padding="16,12" Margin="0,35,0,0" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Foreground="#73E4BF" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="نصبی، سریع و کاملاً آفلاین" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#F8FBFD">
            <Grid Margin="58,42">
                <StackPanel Width="340" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeText" Text="ورود امن به سامانه" Foreground="{StaticResource MutedBrush}" FontSize="14"/>
                    <TextBlock Text="حساب مدیر" FontSize="29" FontWeight="Bold" Margin="0,7,0,30"/>
                    <TextBlock Text="نام کاربری" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="Username" Text="admin" FlowDirection="LeftToRight" TextAlignment="Left"/>
                    <TextBlock Text="رمز عبور" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,7"/>
                    <PasswordBox x:Name="Password" FlowDirection="LeftToRight"/>
                    <StackPanel x:Name="ConfirmPanel">
                        <TextBlock Text="تکرار رمز عبور" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,7"/>
                        <PasswordBox x:Name="ConfirmPassword" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0" MinHeight="20"/>
                    <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Content="ورود به سامانه"
                            Margin="0,15,0,0" Height="52" FontSize="15" Click="Login_Click"/>
                    <TextBlock Text="اطلاعات در همین کمپیوتر نگهداری می‌شود." Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
