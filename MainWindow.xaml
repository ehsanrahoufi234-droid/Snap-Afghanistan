<Window x:Class="SnapAfghanistan.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اسنپ افغانستان — نسخه ۱.۰" MinWidth="1120" MinHeight="700" WindowState="Maximized" Icon="Assets/snap.ico">
    <Grid FlowDirection="LeftToRight" Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="252"/></Grid.ColumnDefinitions>

        <Grid Grid.Column="0" FlowDirection="RightToLeft">
            <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition/></Grid.RowDefinitions>
            <Border Background="#F9FCFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="26,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="داشبورد مدیریتی" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock x:Name="PageSubtitle" Text="تصویر روشن از اعضا، مراکز و سررسیدها" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="15,9" VerticalAlignment="Center" CornerRadius="11">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="هجری شمسی" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                <TextBlock x:Name="SolarDate" FontWeight="Bold" FontSize="13" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <Border Width="1" Background="{StaticResource LineBrush}" Margin="0,2,14,2"/>
                            <StackPanel>
                                <TextBlock Text="میلادی" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                <TextBlock x:Name="GregorianDate" FontWeight="Bold" FontSize="13" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="{StaticResource BackgroundBrush}">
                <ContentControl x:Name="PageHost" Margin="20" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                        Background="#E9142536" CornerRadius="10" Padding="20,12">
                    <TextBlock x:Name="ToastText" Foreground="White" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Column="1" Background="{StaticResource NavyBrush}" FlowDirection="RightToLeft">
            <Grid Margin="15,18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <Border Background="#F5FFFFFF" CornerRadius="13" Padding="7" Width="92" Height="72" HorizontalAlignment="Right">
                        <Image Source="Assets/snap-logo.png" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="اسنپ افغانستان" Foreground="White" FontSize="18" FontWeight="Bold" Margin="5,14,5,3"/>
                    <TextBlock Text="مدیریت اعضا و مراکز" Foreground="#9FB7C8" FontSize="11" Margin="5,0,5,18"/>
                    <Border Height="1" Background="#28FFFFFF"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <Button x:Name="DashboardButton" Tag="dashboard" Content="⌂     داشبورد مدیریتی" Style="{StaticResource ActiveNavButtonStyle}" Click="Navigate"/>
                    <Button x:Name="MembersButton" Tag="members" Content="♙     اعضا" Style="{StaticResource NavButtonStyle}" Click="Navigate"/>
                    <Button x:Name="CentersButton" Tag="centers" Content="▦     سکتورها و مراکز" Style="{StaticResource NavButtonStyle}" Click="Navigate"/>
                    <Button x:Name="SubscriptionsButton" Tag="subscriptions" Content="◷     اشتراک مراکز" Style="{StaticResource NavButtonStyle}" Click="Navigate"/>
                    <Button x:Name="ReportsButton" Tag="reports" Content="▤     گزارش‌ها و PDF" Style="{StaticResource NavButtonStyle}" Click="Navigate"/>
                    <Button x:Name="NotesButton" Tag="notes" Content="✎     یادداشت‌ها" Style="{StaticResource NavButtonStyle}" Click="Navigate"/>
                    <Button x:Name="SettingsButton" Tag="settings" Content="⚙     تنظیمات و بکاپ" Style="{StaticResource NavButtonStyle}" Click="Navigate"/>
                </StackPanel>

                <Border Grid.Row="2" Background="#14FFFFFF" CornerRadius="11" Padding="13,10">
                    <StackPanel>
                        <TextBlock Text="●  آماده و آفلاین" Foreground="#75DDBD" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="نسخه ۱.۰ — دیتابیس محلی" Foreground="#90A9BA" FontSize="10" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
