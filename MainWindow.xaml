<Window x:Class="SnapAfghanistan.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اسنپ افغانستان — نسخه ۱.۲"
        MinWidth="1024" MinHeight="640"
        WindowState="Maximized" ResizeMode="CanResize" Icon="Assets/snap.ico">
    <!-- Root stays LTR only to place the navigation physically on the right.
         Every user-facing workspace is explicitly RTL. -->
    <Grid FlowDirection="LeftToRight" Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- Main workspace -->
        <Grid Grid.Column="0" FlowDirection="RightToLeft">
            <Grid.RowDefinitions>
                <RowDefinition Height="88"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FCFDFE" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="22,0" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="5" Height="47" Background="{StaticResource EmeraldBrush}" CornerRadius="3"/>
                        <StackPanel Grid.Column="2" FlowDirection="RightToLeft" VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="داشبورد مدیریتی" Style="{StaticResource PageTitleStyle}" TextAlignment="Right"/>
                            <TextBlock x:Name="PageSubtitle" Text="تصویر روشن از اعضا، مراکز و سررسیدها"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Padding="14,9" VerticalAlignment="Center" CornerRadius="12">
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                            <Border Width="34" Height="34" Background="#EAF4F7" CornerRadius="10">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,14,0">
                                <TextBlock Text="هجری شمسی" Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Right"/>
                                <TextBlock x:Name="SolarDate" FontWeight="SemiBold" FontSize="12" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <Border Width="1" Background="{StaticResource LineBrush}" Margin="0,2,14,2"/>
                            <StackPanel>
                                <TextBlock Text="میلادی" Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Right"/>
                                <TextBlock x:Name="GregorianDate" FontWeight="SemiBold" FontSize="12" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="{StaticResource BackgroundBrush}" FlowDirection="RightToLeft">
                <ContentControl x:Name="PageHost" Margin="18" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                        Background="#EC102F46" CornerRadius="12" Padding="22,13" Effect="{StaticResource SoftShadow}">
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                        <TextBlock Text="✓" Foreground="#7BE0C4" FontWeight="Bold" Margin="0,0,9,0"/>
                        <TextBlock x:Name="ToastText" Foreground="White" FontWeight="SemiBold" TextAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Right navigation. Text is intentionally closest to the right edge; icon follows to its left. -->
        <Border Grid.Column="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#082A45" Offset="0"/>
                    <GradientStop Color="#0A3855" Offset="0.58"/>
                    <GradientStop Color="#0A4C58" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="14,15" FlowDirection="RightToLeft">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand: title on the right, logo on its left. -->
                <Grid Margin="6,3,6,16" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="72" Height="58" Background="#F8FFFFFF" CornerRadius="14" Padding="6" HorizontalAlignment="Left">
                        <Image Source="Assets/snap-logo.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" FlowDirection="RightToLeft" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="اسنپ افغانستان" Foreground="White" FontSize="18" FontWeight="SemiBold" TextAlignment="Right"/>
                        <TextBlock Text="مدیریت اعضا و مراکز" Foreground="#9FC1CE" FontSize="11" Margin="0,5,0,0" TextAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,2,0,10" FlowDirection="RightToLeft">
                        <TextBlock Text="منوی اصلی" Foreground="#7196A9" FontSize="10" FontWeight="Bold"
                                   Margin="13,0,13,8" TextAlignment="Right"/>

                        <Button x:Name="DashboardButton" Tag="dashboard" Style="{StaticResource ActiveNavButtonStyle}" Click="Navigate">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" Background="#18FFFFFF" CornerRadius="10" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="داشبورد مدیریتی" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/>
                            </Grid>
                        </Button>

                        <Button x:Name="MembersButton" Tag="members" Style="{StaticResource NavButtonStyle}" Click="Navigate">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" Background="#18FFFFFF" CornerRadius="10" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="اعضا" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/>
                            </Grid>
                        </Button>

                        <Button x:Name="CentersButton" Tag="centers" Style="{StaticResource NavButtonStyle}" Click="Navigate">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" Background="#18FFFFFF" CornerRadius="10" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="سکتورها و مراکز" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/>
                            </Grid>
                        </Button>

                        <Button x:Name="SubscriptionsButton" Tag="subscriptions" Style="{StaticResource NavButtonStyle}" Click="Navigate">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" Background="#18FFFFFF" CornerRadius="10" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="اشتراک مراکز" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/>
                            </Grid>
                        </Button>

                        <Button x:Name="ReportsButton" Tag="reports" Style="{StaticResource NavButtonStyle}" Click="Navigate">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" Background="#18FFFFFF" CornerRadius="10" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="گزارش‌ها و PDF" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NotesButton" Tag="notes" Style="{StaticResource NavButtonStyle}" Click="Navigate">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" Background="#18FFFFFF" CornerRadius="10" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="یادداشت‌ها" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/>
                            </Grid>
                        </Button>

                        <Button x:Name="SettingsButton" Tag="settings" Style="{StaticResource NavButtonStyle}" Click="Navigate">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" Background="#18FFFFFF" CornerRadius="10" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="تنظیمات و بکاپ" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="12" Padding="13,10">
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="28" Height="28" Background="#183FE3B8" CornerRadius="14">
                            <TextBlock Text="✓" Foreground="#81E1C5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" FlowDirection="RightToLeft" Margin="10,0,0,0">
                            <TextBlock Text="آماده برای کار" Foreground="#8EE4CA" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Text="نسخه ۱.۲  •  آفلاین" Foreground="#86A8B7" FontSize="10" Margin="0,4,0,0" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
