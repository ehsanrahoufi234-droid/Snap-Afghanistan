<Window x:Class="SnapAfghanistan.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اسنپ افغانستان — نسخه 1.3"
        MinWidth="900" MinHeight="560"
        WindowState="Maximized" ResizeMode="CanResize" Icon="Assets/snap.ico">
    <Grid FlowDirection="LeftToRight" Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>

        <Grid Grid.Column="0" FlowDirection="RightToLeft">
            <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition/></Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FCFDFE" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="20,0" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                    <!-- Brand fixed to the physical top-left corner of the workspace. -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" FlowDirection="LeftToRight" Margin="0,0,24,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="60" Height="54" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="5" HorizontalAlignment="Left">
                            <Image Source="Assets/snap-logo.png" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" FlowDirection="RightToLeft">
                            <TextBlock Text="اسنپ افغانستان" Foreground="{StaticResource InkBrush}" FontSize="17" FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Text="مدیریت اعضا و مراکز" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1" VerticalAlignment="Center" FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                            <TextBlock x:Name="PageTitle" Text="داشبورد مدیریتی" Style="{StaticResource PageTitleStyle}" TextAlignment="Right"/>
                            <TextBlock x:Name="PageSubtitle" Text="تصویر روشن از اعضا، مراکز و سررسیدها" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextAlignment="Right"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="5" Height="47" Background="{StaticResource EmeraldBrush}" CornerRadius="3"/>
                    </Grid>

                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,8" VerticalAlignment="Center" CornerRadius="12" Margin="22,0,0,0">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Background="#EAF4F7" CornerRadius="10">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" FlowDirection="RightToLeft">
                                <TextBlock Text="امروز — هجری شمسی" Foreground="{StaticResource MutedBrush}" FontSize="9" TextAlignment="Right"/>
                                <TextBlock x:Name="SolarDate" FontWeight="SemiBold" FontSize="14" FlowDirection="LeftToRight"/>
                                <TextBlock x:Name="GregorianDate" Foreground="#9AA8B4" FontSize="9" FlowDirection="LeftToRight" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="{StaticResource BackgroundBrush}" FlowDirection="RightToLeft">
                <ContentControl x:Name="PageHost" Margin="18" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" Background="#EC102F46" CornerRadius="12" Padding="22,13" Effect="{StaticResource SoftShadow}">
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><TextBlock Text="✓" Foreground="#7BE0C4" FontWeight="Bold" Margin="0,0,9,0"/><TextBlock x:Name="ToastText" Foreground="White" FontWeight="SemiBold" TextAlignment="Right"/></StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Column="1">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#082A45" Offset="0"/><GradientStop Color="#0A3855" Offset="0.58"/><GradientStop Color="#0A4C58" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid Margin="14,15" FlowDirection="RightToLeft">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="12" Padding="13,10" Margin="0,0,0,12">
                    <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="#18FFFFFF" CornerRadius="10"><TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="#A9C8D5" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" FlowDirection="RightToLeft" Margin="10,0,0,0"><TextBlock Text="منوی مدیریت" Foreground="White" FontWeight="SemiBold" FontSize="12" TextAlignment="Right"/><TextBlock Text="دسترسی سریع به بخش‌ها" Foreground="#86A8B7" FontSize="9" Margin="0,3,0,0" TextAlignment="Right"/></StackPanel></Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,2,0,10" FlowDirection="RightToLeft">
                        <Button x:Name="DashboardButton" Tag="dashboard" Style="{StaticResource ActiveNavButtonStyle}" Click="Navigate"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Width="34" Height="34" Background="#18FFFFFF" CornerRadius="10" HorizontalAlignment="Left"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="داشبورد مدیریتی" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/></Grid></Button>
                        <Button x:Name="MembersButton" Tag="members" Style="{StaticResource NavButtonStyle}" Click="Navigate"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Width="34" Height="34" Background="#18FFFFFF" CornerRadius="10" HorizontalAlignment="Left"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="اعضا" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/></Grid></Button>
                        <Button x:Name="CentersButton" Tag="centers" Style="{StaticResource NavButtonStyle}" Click="Navigate"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Width="34" Height="34" Background="#18FFFFFF" CornerRadius="10" HorizontalAlignment="Left"><TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="سکتورها و مراکز" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/></Grid></Button>
                        <Button x:Name="SubscriptionsButton" Tag="subscriptions" Style="{StaticResource NavButtonStyle}" Click="Navigate"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Width="34" Height="34" Background="#18FFFFFF" CornerRadius="10" HorizontalAlignment="Left"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="اشتراک مراکز" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/></Grid></Button>
                        <Button x:Name="ReportsButton" Tag="reports" Style="{StaticResource NavButtonStyle}" Click="Navigate"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Width="34" Height="34" Background="#18FFFFFF" CornerRadius="10" HorizontalAlignment="Left"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="گزارش‌ها و PDF" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/></Grid></Button>
                        <Button x:Name="NotesButton" Tag="notes" Style="{StaticResource NavButtonStyle}" Click="Navigate"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Width="34" Height="34" Background="#18FFFFFF" CornerRadius="10" HorizontalAlignment="Left"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="یادداشت‌ها" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/></Grid></Button>
                        <Button x:Name="SettingsButton" Tag="settings" Style="{StaticResource NavButtonStyle}" Click="Navigate"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Width="34" Height="34" Background="#18FFFFFF" CornerRadius="10" HorizontalAlignment="Left"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="تنظیمات و بکاپ" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/></Grid></Button>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="12" Padding="13,10">
                    <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Width="28" Height="28" Background="#183FE3B8" CornerRadius="14"><TextBlock Text="✓" Foreground="#81E1C5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" FlowDirection="RightToLeft" Margin="10,0,0,0"><TextBlock Text="آماده برای کار" Foreground="#8EE4CA" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/><TextBlock Text="نسخه 1.3  •  آفلاین" Foreground="#86A8B7" FontSize="10" Margin="0,4,0,0" TextAlignment="Right"/></StackPanel></Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>