<UserControl x:Class="SnapAfghanistan.Native.Views.CentersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="205"/><ColumnDefinition Width="165"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="جستجوی مراکز" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="SearchText" ToolTip="نام، کد، موبایل یا نماینده" KeyDown="Search_KeyDown"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="سکتور" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="SectorFilter" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Filter_Changed"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock Text="وضعیت مرکز" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="StatusFilter" SelectionChanged="Filter_Changed"/></StackPanel>
                <Button Grid.Column="3" Content="جستجو" Style="{StaticResource PrimaryButton}" Margin="12,20,0,0" Click="Search_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="11" Margin="0,0,0,12">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="＋ ثبت مرکز جدید" Style="{StaticResource SuccessButton}" MinWidth="150" Click="Add_Click"/>
                <Button Content="ویرایش مرکز" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Edit_Click"/>
                <Button Content="مدیریت سکتورها" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Sectors_Click"/>
                <Button Content="بایگانی" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Archive_Click"/>
                <Button Content="حذف" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <DataGrid x:Name="CentersGrid" AlternationCount="2" MouseDoubleClick="Grid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد مرکز" Binding="{Binding Code}" Width="145"/>
                    <DataGridTextColumn Header="نام مرکز" Binding="{Binding Name}" Width="2*" MinWidth="170"/>
                    <DataGridTextColumn Header="سکتور" Binding="{Binding Sector}" Width="*" MinWidth="125"/>
                    <DataGridTextColumn Header="نماینده" Binding="{Binding Representative}" Width="*" MinWidth="125"/>
                    <DataGridTextColumn Header="شماره موبایل" Binding="{Binding Phone}" Width="130"/>
                    <DataGridTextColumn Header="تخفیف" Binding="{Binding Discount}" Width="115"/>
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="12,9" Margin="0,12,0,0">
            <Grid FlowDirection="LeftToRight">
                <TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                    <Button x:Name="PreviousButton" Content="صفحه قبلی" Style="{StaticResource GhostButton}" Width="105" Click="Previous_Click"/>
                    <TextBlock x:Name="PageText" VerticalAlignment="Center" FontWeight="SemiBold" Margin="14,0"/>
                    <Button x:Name="NextButton" Content="صفحه بعدی" Style="{StaticResource GhostButton}" Width="105" Click="Next_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
