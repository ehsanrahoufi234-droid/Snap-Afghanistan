<UserControl x:Class="SnapAfghanistan.Native.Views.CentersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="165"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchText" Grid.Column="0" ToolTip="نام، کد، موبایل یا نماینده" KeyDown="Search_KeyDown"/><ComboBox x:Name="SectorFilter" Grid.Column="1" Margin="10,0,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Filter_Changed"/><ComboBox x:Name="StatusFilter" Grid.Column="2" Margin="10,0,0,0" SelectionChanged="Filter_Changed"/><Button Grid.Column="3" Content="جستجو" Style="{StaticResource PrimaryButton}" Width="100" Margin="10,0,0,0" Click="Search_Click"/></Grid></Border>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><Button Content="＋ ثبت مرکز" Style="{StaticResource SuccessButton}" Click="Add_Click"/><Button Content="ویرایش مرکز" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Edit_Click"/><Button Content="مدیریت سکتورها" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Sectors_Click"/><Button Content="بایگانی" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Archive_Click"/><Button Content="حذف" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click"/></StackPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True"><DataGrid x:Name="CentersGrid" AlternationCount="2" MouseDoubleClick="Grid_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="130"/><DataGridTextColumn Header="نام مرکز" Binding="{Binding Name}" Width="2*" MinWidth="150"/><DataGridTextColumn Header="سکتور" Binding="{Binding Sector}" Width="*" MinWidth="110"/><DataGridTextColumn Header="نماینده" Binding="{Binding Representative}" Width="*" MinWidth="110"/><DataGridTextColumn Header="موبایل" Binding="{Binding Phone}" Width="115"/><DataGridTextColumn Header="تخفیف" Binding="{Binding Discount}" Width="100"/><DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="85"/></DataGrid.Columns></DataGrid></Border>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="12,9" Margin="0,12,0,0"><Grid><TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button x:Name="NextButton" Content="بعدی ‹" Style="{StaticResource GhostButton}" Width="88" Click="Next_Click"/><TextBlock x:Name="PageText" VerticalAlignment="Center" FontWeight="Bold" Margin="14,0"/><Button x:Name="PreviousButton" Content="› قبلی" Style="{StaticResource GhostButton}" Width="88" Click="Previous_Click"/></StackPanel></Grid></Border>
    </Grid>
</UserControl>
