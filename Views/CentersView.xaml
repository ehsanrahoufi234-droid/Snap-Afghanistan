<UserControl x:Class="SnapAfghanistan.Native.Views.CentersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ElevatedCardStyle}" Padding="17" Margin="0,0,0,12" CornerRadius="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="112"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="جستجوی مرکز" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="SearchText" ToolTip="نام مرکز، کد، موبایل یا نماینده" KeyDown="Search_KeyDown"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="سکتور مرکز" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="SectorFilter"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              TextSearch.TextPath="Name"
                              SelectionChanged="Filter_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="وضعیت اشتراک" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="StatusFilter" SelectionChanged="Filter_Changed"/>
                </StackPanel>

                <Button Grid.Column="3" Content="جستجو" Style="{StaticResource PrimaryButton}" Margin="12,20,0,0" Click="Search_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12" CornerRadius="16" Background="#FBFCFD">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="＋ ثبت مرکز جدید" Style="{StaticResource SuccessButton}" MinWidth="150" Click="Add_Click"/>
                    <Button Content="ویرایش مرکز" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Edit_Click"/>
                    <Button Content="مدیریت سکتورها" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Sectors_Click"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft">
                    <Button Content="بایگانی" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Archive_Click"/>
                    <Button Content="حذف" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ElevatedCardStyle}" Padding="0" ClipToBounds="True" CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Border Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="15,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="فهرست مراکز همکار" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="روی هر ردیف دوبار کلیک کنید تا پرونده مرکز باز شود." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#EEF5F9" CornerRadius="10" Padding="11,6" VerticalAlignment="Center">
                            <TextBlock Text="شبکه مراکز" Foreground="#506D80" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1" x:Name="CentersGrid" AlternationCount="2" MouseDoubleClick="Grid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="کد مرکز" Binding="{Binding Code}" Width="145"/>
                        <DataGridTextColumn Header="نام مرکز" Binding="{Binding Name}" Width="2*" MinWidth="170"/>
                        <DataGridTextColumn Header="سکتور" Binding="{Binding Sector}" Width="*" MinWidth="125"/>
                        <DataGridTextColumn Header="نماینده" Binding="{Binding Representative}" Width="*" MinWidth="125"/>
                        <DataGridTextColumn Header="شماره موبایل" Binding="{Binding Phone}" Width="130"/>
                        <DataGridTextColumn Header="تخفیف" Binding="{Binding Discount}" Width="100"/>
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="95"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="12,9" Margin="0,12,0,0" CornerRadius="14" Background="#FBFCFD">
            <Grid FlowDirection="LeftToRight">
                <TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                    <Button x:Name="PreviousButton" Content="صفحه قبلی" Style="{StaticResource GhostButton}" Width="105" Click="Previous_Click"/>
                    <TextBlock x:Name="PageText" VerticalAlignment="Center" FontWeight="SemiBold" Margin="14,0" FlowDirection="RightToLeft"/>
                    <Button x:Name="NextButton" Content="صفحه بعدی" Style="{StaticResource GhostButton}" Width="105" Click="Next_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
