<UserControl x:Class="SnapAfghanistan.Native.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="0,0,0,0" BorderBrush="#A9D7C9" Background="#F4FBF8" FlowDirection="RightToLeft">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="اعضای فعال" Foreground="#397061" FontWeight="Bold"/><TextBlock x:Name="ActiveMembers" Text="۰" FontSize="29" FontWeight="Bold" Foreground="#087E61" Margin="0,9,0,0"/></StackPanel><Border Grid.Column="1" Width="48" Height="48" Background="#D9F2EA" CornerRadius="13"><TextBlock Text="♙" FontSize="22" Foreground="#087E61" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="12,0,0,0" BorderBrush="#BBD0EE" Background="#F5F8FD" FlowDirection="RightToLeft">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="مراکز ثبت‌شده" Foreground="#4B6184" FontWeight="Bold"/><TextBlock x:Name="Centers" Text="۰" FontSize="29" FontWeight="Bold" Foreground="#2B67C8" Margin="0,9,0,0"/></StackPanel><Border Grid.Column="1" Width="48" Height="48" Background="#DEE9F9" CornerRadius="13"><TextBlock Text="▦" FontSize="20" Foreground="#2B67C8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0" BorderBrush="#EFD2A6" Background="#FFF9F0" FlowDirection="RightToLeft">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="نزدیک سررسید" Foreground="#835B28" FontWeight="Bold"/><TextBlock x:Name="NearDue" Text="۰" FontSize="29" FontWeight="Bold" Foreground="#D37B13" Margin="0,9,0,0"/></StackPanel><Border Grid.Column="1" Width="48" Height="48" Background="#FBE8CB" CornerRadius="13"><TextBlock Text="◷" FontSize="22" Foreground="#D37B13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                </Border>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="12,0,0,0" BorderBrush="#EDB8C0" Background="#FFF5F6" FlowDirection="RightToLeft">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="اشتراک معوق" Foreground="#834553" FontWeight="Bold"/><TextBlock x:Name="Overdue" Text="۰" FontSize="29" FontWeight="Bold" Foreground="#C73348" Margin="0,9,0,0"/></StackPanel><Border Grid.Column="1" Width="48" Height="48" Background="#F8DDE2" CornerRadius="13"><TextBlock Text="!" FontSize="22" FontWeight="Bold" Foreground="#C73348" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" FlowDirection="RightToLeft">
                    <StackPanel>
                        <TextBlock Text="ترکیب اعضای اسنپ" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="تعداد اعضای فعال در هر گروه" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,17"/>
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="4" Background="#EAF7F3" CornerRadius="11" Padding="13" FlowDirection="RightToLeft"><StackPanel><TextBlock Text="معلم" Foreground="#427163" FontWeight="Bold"/><TextBlock x:Name="Teachers" Text="۰" FontSize="24" FontWeight="Bold" Foreground="#087E61" Margin="0,8,0,0"/></StackPanel></Border>
                            <Border Grid.Column="3" Background="#EBF3FC" CornerRadius="11" Padding="13" Margin="9,0,0,0" FlowDirection="RightToLeft"><StackPanel><TextBlock Text="عالم" Foreground="#496786" FontWeight="Bold"/><TextBlock x:Name="Scholars" Text="۰" FontSize="24" FontWeight="Bold" Foreground="#2B67C8" Margin="0,8,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" Background="#F1EDFA" CornerRadius="11" Padding="13" Margin="9,0,0,0" FlowDirection="RightToLeft"><StackPanel><TextBlock Text="استاد پوهنتون" Foreground="#685487" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="Professors" Text="۰" FontSize="24" FontWeight="Bold" Foreground="#7654AF" Margin="0,8,0,0"/></StackPanel></Border>
                            <Border Grid.Column="1" Background="#FFF5E7" CornerRadius="11" Padding="13" Margin="9,0,0,0" FlowDirection="RightToLeft"><StackPanel><TextBlock Text="فرهنگی" Foreground="#8C622C" FontWeight="Bold"/><TextBlock x:Name="Cultural" Text="۰" FontSize="24" FontWeight="Bold" Foreground="#D98519" Margin="0,8,0,0"/></StackPanel></Border>
                            <Border Grid.Column="0" Background="#FCEAEC" CornerRadius="11" Padding="13" Margin="9,0,0,0" FlowDirection="RightToLeft"><StackPanel><TextBlock Text="شاگرد" Foreground="#8B4D58" FontWeight="Bold"/><TextBlock x:Name="Students" Text="۰" FontSize="24" FontWeight="Bold" Foreground="#C73348" Margin="0,8,0,0"/></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0" FlowDirection="RightToLeft">
                    <StackPanel>
                        <TextBlock Text="وضعیت اشتراک‌ها" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="نمای مالی ماه جاری" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,16"/>
                        <Border Background="#E8F5F1" CornerRadius="11" Padding="15"><Grid><StackPanel><TextBlock Text="درآمد ثبت‌شده این ماه" Foreground="#497266"/><TextBlock x:Name="MonthRevenue" Text="۰ افغانی" Foreground="#087E61" FontSize="23" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Grid></Border>
                        <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="1" Background="#FFF4E5" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="نزدیک سررسید" Foreground="#805C31"/><TextBlock x:Name="NearDueSmall" FontSize="19" FontWeight="Bold" Foreground="#D98519" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="0" Background="#FBEAEC" CornerRadius="10" Padding="12" Margin="10,0,0,0"><StackPanel><TextBlock Text="تعلیق" Foreground="#87515B"/><TextBlock x:Name="Suspended" FontSize="19" FontWeight="Bold" Foreground="#C73348" Margin="0,5,0,0"/></StackPanel></Border></Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="18,15" Background="#F9FCFD">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="سامانه آماده کار روزانه است" FontWeight="Bold" FontSize="15"/><TextBlock x:Name="Summary" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="●  SQLite محلی — بدون مرورگر" Foreground="{StaticResource EmeraldBrush}" FontWeight="Bold" VerticalAlignment="Center"/></Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
