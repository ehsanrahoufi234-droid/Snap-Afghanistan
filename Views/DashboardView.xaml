<UserControl x:Class="SnapAfghanistan.Native.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <UniformGrid Rows="1" Columns="4">
                <Border Style="{StaticResource CardStyle}" BorderBrush="#A8D8CA" Background="#F4FBF8" MinHeight="112">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="اعضای فعال" Foreground="#3C7061" FontWeight="SemiBold"/><TextBlock x:Name="ActiveMembers" Text="۰" FontSize="29" FontWeight="SemiBold" Foreground="#087E61" Margin="0,10,0,0"/></StackPanel>
                        <Border Grid.Column="1" Width="48" Height="48" Background="#D9F2EA" CornerRadius="14"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#087E61" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0" BorderBrush="#B9D1EE" Background="#F5F8FD" MinHeight="112">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="مراکز ثبت‌شده" Foreground="#4D6281" FontWeight="SemiBold"/><TextBlock x:Name="Centers" Text="۰" FontSize="29" FontWeight="SemiBold" Foreground="#2B67C8" Margin="0,10,0,0"/></StackPanel>
                        <Border Grid.Column="1" Width="48" Height="48" Background="#DEE9F9" CornerRadius="14"><TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#2B67C8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0" BorderBrush="#EFD2A6" Background="#FFF9F0" MinHeight="112">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="نزدیک سررسید" Foreground="#825C2B" FontWeight="SemiBold"/><TextBlock x:Name="NearDue" Text="۰" FontSize="29" FontWeight="SemiBold" Foreground="#D37B13" Margin="0,10,0,0"/></StackPanel>
                        <Border Grid.Column="1" Width="48" Height="48" Background="#FBE8CB" CornerRadius="14"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#D37B13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0" BorderBrush="#EDB8C0" Background="#FFF5F6" MinHeight="112">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="اشتراک معوق" Foreground="#824653" FontWeight="SemiBold"/><TextBlock x:Name="Overdue" Text="۰" FontSize="29" FontWeight="SemiBold" Foreground="#C73348" Margin="0,10,0,0"/></StackPanel>
                        <Border Grid.Column="1" Width="48" Height="48" Background="#F8DDE2" CornerRadius="14"><TextBlock Text="!" FontSize="21" FontWeight="Bold" Foreground="#C73348" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>
                        <Grid>
                            <StackPanel><TextBlock Text="ترکیب اعضای اسنپ" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="تعداد اعضای فعال در هر گروه" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                            <Border Width="38" Height="38" Background="#EDF4F8" CornerRadius="11" HorizontalAlignment="Left"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        </Grid>
                        <UniformGrid Rows="1" Columns="5" Margin="0,18,0,0">
                            <Border Background="#EAF7F3" BorderBrush="#CDEADF" BorderThickness="1" CornerRadius="12" Padding="13"><StackPanel><TextBlock Text="معلم" Foreground="#427163" FontWeight="SemiBold"/><TextBlock x:Name="Teachers" Text="۰" FontSize="24" FontWeight="SemiBold" Foreground="#087E61" Margin="0,8,0,0"/></StackPanel></Border>
                            <Border Background="#EBF3FC" BorderBrush="#D4E3F5" BorderThickness="1" CornerRadius="12" Padding="13" Margin="8,0,0,0"><StackPanel><TextBlock Text="عالم" Foreground="#496786" FontWeight="SemiBold"/><TextBlock x:Name="Scholars" Text="۰" FontSize="24" FontWeight="SemiBold" Foreground="#2B67C8" Margin="0,8,0,0"/></StackPanel></Border>
                            <Border Background="#F1EDFA" BorderBrush="#E1D9F1" BorderThickness="1" CornerRadius="12" Padding="13" Margin="8,0,0,0"><StackPanel><TextBlock Text="استاد پوهنتون" Foreground="#685487" FontWeight="SemiBold" FontSize="11"/><TextBlock x:Name="Professors" Text="۰" FontSize="24" FontWeight="SemiBold" Foreground="#7654AF" Margin="0,8,0,0"/></StackPanel></Border>
                            <Border Background="#FFF5E7" BorderBrush="#F2DFC3" BorderThickness="1" CornerRadius="12" Padding="13" Margin="8,0,0,0"><StackPanel><TextBlock Text="فرهنگی" Foreground="#8C622C" FontWeight="SemiBold"/><TextBlock x:Name="Cultural" Text="۰" FontSize="24" FontWeight="SemiBold" Foreground="#D98519" Margin="0,8,0,0"/></StackPanel></Border>
                            <Border Background="#FCEAEC" BorderBrush="#F0D2D7" BorderThickness="1" CornerRadius="12" Padding="13" Margin="8,0,0,0"><StackPanel><TextBlock Text="شاگرد" Foreground="#8B4D58" FontWeight="SemiBold"/><TextBlock x:Name="Students" Text="۰" FontSize="24" FontWeight="SemiBold" Foreground="#C73348" Margin="0,8,0,0"/></StackPanel></Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="وضعیت اشتراک‌ها" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="نمای مالی ماه جاری" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,16"/>
                        <Border Background="#E8F5F1" BorderBrush="#D0EAE2" BorderThickness="1" CornerRadius="12" Padding="15">
                            <StackPanel><TextBlock Text="درآمد ثبت‌شده این ماه" Foreground="#497266"/><TextBlock x:Name="MonthRevenue" Text="۰ افغانی" Foreground="#087E61" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                        </Border>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#FFF4E5" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="نزدیک سررسید" Foreground="#805C31" FontSize="11"/><TextBlock x:Name="NearDueSmall" FontSize="19" FontWeight="SemiBold" Foreground="#D98519" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" Background="#FBEAEC" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="تعلیق" Foreground="#87515B" FontSize="11"/><TextBlock x:Name="Suspended" FontSize="19" FontWeight="SemiBold" Foreground="#C73348" Margin="0,5,0,0"/></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="17,13" Background="#F9FCFD">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="سامانه آماده کار روزانه است" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="Summary" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    <Border Grid.Column="1" Background="#E8F5F1" CornerRadius="10" Padding="13,8" VerticalAlignment="Center"><TextBlock Text="●  دیتابیس محلی — بدون مرورگر" Foreground="{StaticResource EmeraldBrush}" FontWeight="SemiBold" FontSize="11"/></Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
