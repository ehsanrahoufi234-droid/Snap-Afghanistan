<UserControl x:Class="SnapAfghanistan.Native.Views.MembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="135"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchText" Grid.Column="0" ToolTip="کد، نام، تذکره، موبایل یا اداره" KeyDown="Search_KeyDown"/>
                <ComboBox x:Name="TypeFilter" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="Filter_Changed"/>
                <ComboBox x:Name="StatusFilter" Grid.Column="2" Margin="10,0,0,0" SelectionChanged="Filter_Changed"/>
                <Button Grid.Column="3" Content="جستجو" Style="{StaticResource PrimaryButton}" Width="100" Margin="10,0,0,0" Click="Search_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal"><Button Content="＋ ثبت عضو" Style="{StaticResource SuccessButton}" Click="Add_Click"/><Button Content="ویرایش" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Edit_Click"/><Button Content="مشاهده پرونده" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="View_Click"/><Button Content="PDF انفرادی" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Pdf_Click"/><Button Content="بایگانی" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Archive_Click"/><Button Content="حذف" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click"/></StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <DataGrid x:Name="MembersGrid" AlternationCount="2" MouseDoubleClick="Grid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="130"/>
                    <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*" MinWidth="115"/>
                    <DataGridTextColumn Header="نام پدر" Binding="{Binding FatherName}" Width="*" MinWidth="110"/>
                    <DataGridTextColumn Header="گروه" Binding="{Binding Type}" Width="115"/>
                    <DataGridTextColumn Header="تذکره" Binding="{Binding Tazkira}" Width="125"/>
                    <DataGridTextColumn Header="موبایل" Binding="{Binding Phone}" Width="120"/>
                    <DataGridTextColumn Header="اداره / مکتب" Binding="{Binding Institution}" Width="*" MinWidth="130"/>
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="85"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="12,9" Margin="0,12,0,0">
            <Grid><TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button x:Name="NextButton" Content="بعدی ‹" Style="{StaticResource GhostButton}" Width="88" Click="Next_Click"/><TextBlock x:Name="PageText" VerticalAlignment="Center" FontWeight="Bold" Margin="14,0"/><Button x:Name="PreviousButton" Content="› قبلی" Style="{StaticResource GhostButton}" Width="88" Click="Previous_Click"/></StackPanel></Grid>
        </Border>
    </Grid>
</UserControl>
