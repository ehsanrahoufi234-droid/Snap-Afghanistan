<UserControl x:Class="SnapAfghanistan.Native.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="17" Margin="0,0,0,12"><Grid><StackPanel><TextBlock Text="دفتر پیگیری" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="کارهای روزانه، تماس‌ها و موعدهای مهم را اینجا نگهدارید." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><ComboBox x:Name="StatusFilter" Width="170" HorizontalAlignment="Left" SelectionChanged="Filter_Changed"/></Grid></Border>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><Button Content="＋ یادداشت جدید" Style="{StaticResource SuccessButton}" Click="Add_Click"/><Button Content="ویرایش" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Edit_Click"/><Button Content="حذف" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click"/></StackPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True"><DataGrid x:Name="Grid" AlternationCount="2" MouseDoubleClick="Grid_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="نوع" Binding="{Binding Type}" Width="100"/><DataGridTextColumn Header="مرتبط" Binding="{Binding RelatedName}" Width="*"/><DataGridTextColumn Header="اولویت" Binding="{Binding Priority}" Width="90"/><DataGridTextColumn Header="موعد" Binding="{Binding DueDate}" Width="110"/><DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="توضیحات" Binding="{Binding Body}" Width="2*"/></DataGrid.Columns></DataGrid></Border>
    </Grid>
</UserControl>
