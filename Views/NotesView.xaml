<UserControl x:Class="SnapAfghanistan.Native.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="39" Height="39" Background="#EDF3FA" CornerRadius="11"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="دفتر پیگیری" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="کارهای روزانه، تماس‌ها و موعدهای مهم" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                </Grid>
                <StackPanel Grid.Column="1"><TextBlock Text="فیلتر وضعیت" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="StatusFilter" SelectionChanged="Filter_Changed"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="11" Margin="0,0,0,12">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="＋ یادداشت جدید" Style="{StaticResource SuccessButton}" MinWidth="145" Click="Add_Click"/>
                <Button Content="ویرایش یادداشت" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Edit_Click"/>
                <Button Content="حذف" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <DataGrid x:Name="Grid" AlternationCount="2" MouseDoubleClick="Grid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="2*" MinWidth="180"/>
                    <DataGridTextColumn Header="نوع" Binding="{Binding Type}" Width="110"/>
                    <DataGridTextColumn Header="مرتبط با" Binding="{Binding RelatedName}" Width="*" MinWidth="130"/>
                    <DataGridTextColumn Header="اولویت" Binding="{Binding Priority}" Width="95"/>
                    <DataGridTextColumn Header="موعد" Binding="{Binding DueDate}" Width="120"/>
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="115"/>
                    <DataGridTextColumn Header="توضیحات" Binding="{Binding Body}" Width="2*" MinWidth="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
