<UserControl x:Class="SnapAfghanistan.Native.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="مرکز گزارش‌گیری" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="نوع گزارش و گروه مورد نظر را انتخاب کنید؛ سپس نتیجه را پیش‌نمایش بگیرید." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" Background="#EAF3FA" CornerRadius="11" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,19,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="نوع گزارش" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="ReportType" SelectionChanged="ReportType_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="گروه عضو" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="MemberType"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#F5F8FA" CornerRadius="10" Padding="13,9" Margin="12,0" VerticalAlignment="Bottom">
                        <TextBlock Text="گزارش انفرادی هر عضو از صفحه اعضا قابل دریافت است." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="3" Content="مشاهده گزارش" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Click="Preview_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <TextBlock x:Name="CountText" Text="هنوز گزارشی ساخته نشده است" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" FlowDirection="RightToLeft">
                    <Button Content="دریافت PDF با لوگو" Style="{StaticResource DangerButton}" MinWidth="170" Click="Pdf_Click"/>
                    <Button Content="دریافت فایل CSV" Style="{StaticResource SuccessButton}" MinWidth="150" Margin="8,0,0,0" Click="Csv_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="Grid" AutoGenerateColumns="True" AlternationCount="2"
                          AutoGeneratingColumn="Grid_AutoGeneratingColumn"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
