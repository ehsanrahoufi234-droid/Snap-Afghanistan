<UserControl x:Class="SnapAfghanistan.Native.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="190"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="نوع گزارش" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="ReportType" SelectionChanged="ReportType_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="گروه عضو" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="MemberType"/></StackPanel><TextBlock Grid.Column="2" Text="گزارش انفرادی هر عضو از صفحه اعضا قابل دریافت است." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="16,0"/><Button Grid.Column="3" Content="مشاهده گزارش" Style="{StaticResource PrimaryButton}" Width="130" VerticalAlignment="Bottom" Click="Preview_Click"/></Grid></Border>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12"><Grid><StackPanel Orientation="Horizontal"><Button Content="خروجی PDF با لوگو" Style="{StaticResource DangerButton}" Click="Pdf_Click"/><Button Content="خروجی CSV" Style="{StaticResource SuccessButton}" Margin="8,0,0,0" Click="Csv_Click"/></StackPanel><TextBlock x:Name="CountText" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/></Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True"><DataGrid x:Name="Grid" AutoGenerateColumns="True" AlternationCount="2"/></Border>
    </Grid>
</UserControl>
