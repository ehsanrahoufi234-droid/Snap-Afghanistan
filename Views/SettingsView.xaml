<UserControl x:Class="SnapAfghanistan.Native.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" FontSize="14">
        <TabItem x:Name="GeneralTab" Header="تنظیمات عمومی"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="25"><StackPanel MaxWidth="760" HorizontalAlignment="Right">
            <TextBlock Text="هویت و رفتار سامانه" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="این تنظیمات در گزارش‌ها و کدهای عضویت استفاده می‌شود." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,24"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="2"><TextBlock Text="نام دفتر" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="CompanyNameText"/></StackPanel><StackPanel Grid.Column="0"><TextBlock Text="ولایت" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="ProvinceText"/></StackPanel></Grid>
            <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="2"><TextBlock Text="پیشوند کد اعضا" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="PrefixText" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel><StackPanel Grid.Column="0"><TextBlock Text="یادآوری چند روز قبل از سررسید" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="ReminderText" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel></Grid>
            <CheckBox x:Name="AutoBackupCheck" Content="بکاپ خودکار روزانه روی کمپیوتر اصلی فعال باشد" FontWeight="SemiBold" Margin="0,20,0,0"/>
            <Button x:Name="SaveSettingsButton" Content="ذخیره تنظیمات" Style="{StaticResource PrimaryButton}" Width="150" HorizontalAlignment="Left" Margin="0,25,0,0" Click="SaveSettings_Click"/>
        </StackPanel></Border></ScrollViewer></TabItem>

        <TabItem Header="امنیت و بکاپ"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="24"><StackPanel><TextBlock Text="پشتیبان‌گیری مرکزی" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="BackupHelpText" Text="بکاپ شامل دیتابیس و فایل‌های تذکره است و فقط روی Server ساخته می‌شود." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,18"/><Button x:Name="BackupButton" Content="ایجاد بکاپ" Style="{StaticResource SuccessButton}" Click="Backup_Click"/><Button x:Name="RestoreButton" Content="بازیابی بکاپ" Style="{StaticResource SecondaryButton}" Margin="0,9,0,0" Click="Restore_Click"/><Button x:Name="OpenDataButton" Content="بازکردن پوشه اطلاعات" Style="{StaticResource GhostButton}" Margin="0,9,0,0" Click="OpenData_Click"/><Border Background="#EEF4F7" CornerRadius="10" Padding="12" Margin="0,16,0,0"><StackPanel><TextBlock Text="محل اطلاعات" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="DataPathText" TextWrapping="Wrap" FontSize="11" FlowDirection="LeftToRight" TextAlignment="Left" Margin="0,5,0,0"/><TextBlock x:Name="DbSizeText" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,6,0,0"/></StackPanel></Border></StackPanel></Border>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="24"><StackPanel><TextBlock Text="رمز حساب فعلی" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="رمز قوی و اختصاصی انتخاب کنید. تغییر نام کاربری نیز از همین بخش انجام می‌شود." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,18"/><TextBlock Text="نام کاربری" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="UsernameText" FlowDirection="LeftToRight" TextAlignment="Left"/><TextBlock Text="رمز فعلی" Style="{StaticResource FieldLabelStyle}" Margin="0,15,0,7"/><PasswordBox x:Name="CurrentPassword" FlowDirection="LeftToRight"/><TextBlock Text="رمز جدید" Style="{StaticResource FieldLabelStyle}" Margin="0,15,0,7"/><PasswordBox x:Name="NewPassword" FlowDirection="LeftToRight"/><TextBlock Text="تکرار رمز جدید" Style="{StaticResource FieldLabelStyle}" Margin="0,15,0,7"/><PasswordBox x:Name="ConfirmPassword" FlowDirection="LeftToRight"/><Button Content="تغییر رمز" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Click="ChangePassword_Click"/></StackPanel></Border>
        </Grid></ScrollViewer></TabItem>

        <TabItem x:Name="UsersTab" Header="کاربران و شبکه"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="24"><StackPanel><TextBlock Text="کاربران دفتر" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="مدیر، حسابدار و کارمند هرکدام حساب مستقل و صلاحیت مشخص دارند." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,18"/><Button x:Name="ManageUsersButton" Content="مدیریت کاربران و صلاحیت‌ها" Style="{StaticResource PrimaryButton}" Click="ManageUsers_Click"/><TextBlock x:Name="CurrentUserText" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/></StackPanel></Border>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="24"><StackPanel><TextBlock Text="شبکه داخلی دفتر" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="NetworkModeText" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="NetworkAddressText" Foreground="{StaticResource MutedBrush}" FlowDirection="LeftToRight" TextAlignment="Left" Margin="0,7,0,0"/><TextBlock x:Name="PairingText" Foreground="{StaticResource MutedBrush}" FlowDirection="LeftToRight" TextAlignment="Left" TextWrapping="Wrap" Margin="0,7,0,0"/><Button x:Name="NetworkSetupButton" Content="تغییر تنظیم شبکه" Style="{StaticResource SecondaryButton}" Margin="0,18,0,0" Click="NetworkSetup_Click"/></StackPanel></Border>
        </Grid></ScrollViewer></TabItem>

        <TabItem x:Name="TrashTab" Header="سطل زباله"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Border Style="{StaticResource CardStyle}" Padding="13" Margin="0,0,0,12"><Grid><StackPanel><TextBlock Text="سطل زباله" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="حذف عادی قابل بازیابی است؛ حذف دایمی برگشت‌پذیر نیست." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><Button x:Name="RestoreTrashButton" Content="بازیابی" Style="{StaticResource SuccessButton}" Click="RestoreTrash_Click"/><Button x:Name="PurgeButton" Content="حذف دایمی" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Purge_Click"/></StackPanel></Grid></Border><Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True"><DataGrid x:Name="TrashGrid" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="نوع" Binding="{Binding EntityType}" Width="100"/><DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="جزئیات" Binding="{Binding Detail}" Width="*"/><DataGridTextColumn Header="تاریخ حذف" Binding="{Binding DeletedAt}" Width="155"/></DataGrid.Columns></DataGrid></Border></Grid></TabItem>
    </TabControl>
</UserControl>
