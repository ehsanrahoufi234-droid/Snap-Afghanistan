<UserControl x:Class="SnapAfghanistan.Native.Views.SubscriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" BorderBrush="#A9D7C9" Background="#F4FBF8" FlowDirection="RightToLeft"><StackPanel><TextBlock Text="درآمد ماه جاری" Foreground="#397061" FontWeight="Bold"/><TextBlock x:Name="RevenueCard" Text="۰ افغانی" FontSize="25" FontWeight="Bold" Foreground="#087E61" Margin="0,9,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="12,0,0,0" BorderBrush="#BBD0EE" Background="#F5F8FD" FlowDirection="RightToLeft"><StackPanel><TextBlock Text="اشتراک فعال" Foreground="#4B6184" FontWeight="Bold"/><TextBlock x:Name="ActiveCard" Text="۰" FontSize="27" FontWeight="Bold" Foreground="#2B67C8" Margin="0,9,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0" BorderBrush="#EFD2A6" Background="#FFF9F0" FlowDirection="RightToLeft"><StackPanel><TextBlock Text="نزدیک سررسید" Foreground="#835B28" FontWeight="Bold"/><TextBlock x:Name="NearCard" Text="۰" FontSize="27" FontWeight="Bold" Foreground="#D37B13" Margin="0,9,0,0"/></StackPanel></Border>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="12,0,0,0" BorderBrush="#EDB8C0" Background="#FFF5F6" FlowDirection="RightToLeft"><StackPanel><TextBlock Text="معوق" Foreground="#834553" FontWeight="Bold"/><TextBlock x:Name="OverdueCard" Text="۰" FontSize="27" FontWeight="Bold" Foreground="#C73348" Margin="0,9,0,0"/></StackPanel></Border>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="13" Margin="0,12,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchText" Grid.Column="0" ToolTip="نام، کد یا موبایل مرکز" KeyDown="Search_KeyDown"/><ComboBox x:Name="StatusFilter" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="Filter_Changed"/><Button Grid.Column="2" Content="جستجو" Style="{StaticResource PrimaryButton}" Width="100" Margin="10,0,0,0" Click="Search_Click"/></Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><Button Content="تنظیم اشتراک" Style="{StaticResource PrimaryButton}" Click="Configure_Click"/><Button Content="ثبت پرداخت" Style="{StaticResource SuccessButton}" Margin="8,0,0,0" Click="Payment_Click"/><Button Content="سوابق پرداخت" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="History_Click"/><Button Content="PDF مراکز معوق" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="OverduePdf_Click"/></StackPanel></Border>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True"><DataGrid x:Name="Grid" AlternationCount="2" MouseDoubleClick="Grid_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="مرکز" Binding="{Binding Name}" Width="2*" MinWidth="150"/><DataGridTextColumn Header="سکتور" Binding="{Binding Sector}" Width="*" MinWidth="110"/><DataGridTextColumn Header="اشتراک ماهانه" Binding="{Binding SubscriptionText}" Width="145"/><DataGridTextColumn Header="آغاز" Binding="{Binding StartDate}" Width="110"/><DataGridTextColumn Header="سررسید" Binding="{Binding DueDate}" Width="110"/><DataGridTextColumn Header="وضعیت" Binding="{Binding SubscriptionStatus}" Width="125"/><DataGridTextColumn Header="موبایل" Binding="{Binding Phone}" Width="120"/></DataGrid.Columns></DataGrid></Border>
    </Grid>
</UserControl>
